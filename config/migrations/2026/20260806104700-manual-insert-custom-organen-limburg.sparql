prefix xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
  graph ?provincieLimburg {
    ?orgaanUri a besluit:Bestuursorgaan .
    ?orgaanUri mu:uuid ?orgaanUuid .
    ?orgaanUri skos:prefLabel ?orgaanLabel .
    ?orgaanUri besluit:classificatie ?orgaanType .
    ?orgaanUri besluit:bestuurt <http://data.lblod.info/id/bestuurseenheden/14278813524c762255aeba149e7d7134ddecfbb43e7d56910731bd4e13e34f39> .

    ?orgaanInTijdUri a besluit:Bestuursorgaan .
    ?orgaanInTijdUri mu:uuid ?orgaanInTijdUuid .
    ?orgaanInTijdUri lmb:heeftBestuursperiode ?bestuursperiode .
    ?orgaanInTijdUri mandaat:bindingStart ?orgaanInTijdStart .
    ?orgaanInTijdUri mandaat:bindingEinde ?orgaanInTijdEinde .

    ?orgaanInTijdUri mandaat:isTijdspecialisatieVan ?orgaanUri .

    ?orgaanUri ext:isFromManualImport "true"  .
    ?orgaanInTijdUri ext:isFromManualImport "true"  .
  }
}
