INSERT {
  graph ?provincieLimburg {
    ?orgaanUri a besluit:Bestuursorgaan .
    ?orgaanUri mu:uuid ?orgaanUuid .
    ?orgaanUri skos:prefLabel ?orgaanLabel .
    ?orgaanUri besluit:classificatie ?orgaanType .
