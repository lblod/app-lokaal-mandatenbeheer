PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX dct: <http://purl.org/dc/terms/>
DELETE {
  GRAPH ?g {
    ?s <http://purl.org/dc/terms/isVersionOf> ?o.
    ?s dct:modified ?oldMod.
  }
}
INSERT {
  GRAPH ?g {
    ?s dct:modified ?now.
  }
}
WHERE {
  GRAPH ?g {
    ?s <http://purl.org/dc/terms/isVersionOf> ?o.
    OPTIONAL {
      ?s dct:modified ?oldMod.
    }
    BIND(NOW() AS ?now)
  }
  ?g ext:ownedBy ?someone.
}
