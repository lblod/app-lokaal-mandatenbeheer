  bind(uri(concat("http://data.lblod.info/id/bestuursorganen/", ?uuid)) as ?orgaanUri) .
  bind(SHA256(concat("organen-provincie-limburg", ?uuid, str(?orgaantype))) as ?orgaanInTijdUuid) .
  bind(uri(concat("http://data.lblod.info/id/bestuursorganen/", ?orgaanInTijdUuid)) as ?orgaanInTijdUri) .
  ?provincieLimburg ext:ownedBy <http://data.lblod.info/id/bestuurseenheden/14278813524c762255aeba149e7d7134ddecfbb43e7d56910731bd4e13e34f39> .
}
;
PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX mandaat: <http://data.vlaanderen.be/ns/mandaat#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX lmb: <http://lblod.data.gift/vocabularies/lmb/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
  GRAPH ?provincieLimburg {
    ?mandaatUri a mandaat:Mandaat ;
                mu:uuid ?uuid ;
                org:role ?mandaatClassificatie .
    ?orgaanInTijd org:hasPost ?mandaatUri .
  }
}
WHERE {
  ?provincieLimburg ext:ownedBy <http://data.lblod.info/id/bestuurseenheden/14278813524c762255aeba149e7d7134ddecfbb43e7d56910731bd4e13e34f39> .
  ?orgaan besluit:bestuurt <http://data.lblod.info/id/bestuurseenheden/14278813524c762255aeba149e7d7134ddecfbb43e7d56910731bd4e13e34f39> .
  ?orgaan mu:uuid ?orgaanUuid .

  ?orgaanInTijd mandaat:isTijdspecialisatieVan ?orgaan .
  ?orgaan besluit:classificatie / skos:inScheme <http://data.lblod.info/id/conceptscheme/LokaalOrgaanClassificatieCode> .

  ?mandaatClassificatie skos:inScheme <http://data.lblod.info/id/conceptscheme/LokaalMandaatClassificatieCode> .

  FILTER NOT EXISTS {
    ?orgaanInTijd org:hasPost / org:role ?mandaatClassificatie .
  }

  BIND(SHA256(CONCAT(?orgaanUuid, STR(?mandaatClassificatie))) AS ?uuid)
  BIND(URI(CONCAT("http://data.lblod.info/id/mandaten/", ?uuid)) AS ?mandaatUri)
}
