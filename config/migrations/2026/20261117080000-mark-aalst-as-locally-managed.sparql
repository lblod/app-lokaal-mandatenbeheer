PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX dct: <http://purl.org/dc/terms/>

DELETE {
  GRAPH ?g {
    ?bestuurseenheid dct:modified ?modified .
  }
}
INSERT {
  GRAPH ?g {
    ?bestuurseenheid ext:isLokaalBeheerd true .
    ?bestuurseenheid dct:modified ?now .
  }
}
WHERE {
  VALUES ?aalstId {
    "974816591f269bb7d74aa1720922651529f3d3b2a787f5c60b73e5a0384950a4" # Gemeente
    "d769b4b9411ad25f67c1d60b0a403178e24a800e1671fb3258280495011d8e18" # OCMW
  }
  GRAPH ?g {
    ?bestuurseenheid a besluit:Bestuurseenheid.
    ?bestuurseenheid mu:uuid ?aalstId .
    OPTIONAL { ?bestuurseenheid dct:modified ?modified . }
  }
  BIND(NOW() AS ?now)
}